rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlotId(slotId) {
      return slotId in ['08:00', '09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00', '17:00'];
    }

    function isValidDateIso(dateIso) {
      return dateIso is string && dateIso.size() == 10 && dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidSlotKeyFormat(slotKey, dateIso, timeSlotId) {
      return slotKey is string &&
             slotKey.size() == 16 &&
             slotKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(08|09|10|11|13|14|15|16|17)-00$') &&
             isValidDateIso(dateIso) &&
             isValidSlotId(timeSlotId) &&
             slotKey[0:10] == dateIso &&
             slotKey[11:13] == timeSlotId[0:2];
    }

    function isValidPriceForServiceAndSize(serviceCode, dogSizeCode, priceCop) {
      return priceCop is int && (
        (serviceCode == 'BANO_BASICO' && dogSizeCode == 'PEQUENO' && priceCop == 35000) ||
        (serviceCode == 'BANO_BASICO' && dogSizeCode == 'MEDIANO' && priceCop == 45000) ||
        (serviceCode == 'BANO_BASICO' && dogSizeCode == 'GRANDE' && priceCop == 55000) ||
        (serviceCode == 'BANO_PREMIUM' && dogSizeCode == 'PEQUENO' && priceCop == 70000) ||
        (serviceCode == 'BANO_PREMIUM' && dogSizeCode == 'MEDIANO' && priceCop == 85000) ||
        (serviceCode == 'BANO_PREMIUM' && dogSizeCode == 'GRANDE' && priceCop == 100000)
      );
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('lastClientName' in data) || (data.lastClientName is string && data.lastClientName.size() <= 100)) &&
             (!('lastClientPhone' in data) || (data.lastClientPhone is string && data.lastClientPhone.size() <= 30)) &&
             (!('lastPetName' in data) || (data.lastPetName is string && data.lastPetName.size() <= 80)) &&
             (!('lastPetBreed' in data) || (data.lastPetBreed is string && data.lastPetBreed.size() <= 80));
    }

    function isValidAppointment(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
             data.clientPhone is string && data.clientPhone.size() >= 7 && data.clientPhone.size() <= 25 &&
             data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 80 &&
             data.petBreed is string && data.petBreed.size() <= 80 &&
             data.serviceCode in ['BANO_BASICO', 'BANO_PREMIUM'] &&
             data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 80 &&
             data.dogSizeCode in ['PEQUENO', 'MEDIANO', 'GRANDE'] &&
             isValidDateIso(data.dateIso) &&
             isValidSlotId(data.timeSlotId) &&
             data.timeSlotLabel is string && data.timeSlotLabel.size() >= 1 && data.timeSlotLabel.size() <= 20 &&
             isValidSlotKeyFormat(data.slotKey, data.dateIso, data.timeSlotId) &&
             isValidPriceForServiceAndSize(data.serviceCode, data.dogSizeCode, data.priceCop) &&
             data.statusCode in ['CONFIRMADA', 'CANCELADA', 'COMPLETADA'];
    }

    function isValidOccupiedSlot(data, slotKey) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.appointmentId) &&
             isValidDateIso(data.dateIso) &&
             isValidSlotId(data.timeSlotId) &&
             isValidSlotKeyFormat(slotKey, data.dateIso, data.timeSlotId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'email',
                         'lastClientName',
                         'lastClientPhone',
                         'lastPetName',
                         'lastPetBreed',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'email',
                         'lastClientName',
                         'lastClientPhone',
                         'lastPetName',
                         'lastPetBreed',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);

      match /appointments/{appointmentId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(appointmentId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(appointmentId) &&
                         isOwner(userId) &&
                         isValidAppointment(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().statusCode == 'CONFIRMADA' &&
                         incoming().keys().hasAll([
                           'userId',
                           'clientName',
                           'clientPhone',
                           'petName',
                           'petBreed',
                           'serviceCode',
                           'serviceName',
                           'dogSizeCode',
                           'dateIso',
                           'timeSlotId',
                           'timeSlotLabel',
                           'slotKey',
                           'priceCop',
                           'statusCode',
                           'createdAt',
                           'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId',
                           'clientName',
                           'clientPhone',
                           'petName',
                           'petBreed',
                           'serviceCode',
                           'serviceName',
                           'dogSizeCode',
                           'dateIso',
                           'timeSlotId',
                           'timeSlotLabel',
                           'slotKey',
                           'priceCop',
                           'statusCode',
                           'createdAt',
                           'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         existsAfter(/databases/$(database)/documents/occupied_slots/$(incoming().slotKey));

        // Terminal state lock: only CONFIRMADA appointments can transition to CANCELADA or COMPLETADA.
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(appointmentId) &&
                         isOwner(userId) &&
                         isValidAppointment(incoming()) &&
                         existing().statusCode == 'CONFIRMADA' &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().clientName == existing().clientName &&
                         incoming().clientPhone == existing().clientPhone &&
                         incoming().petName == existing().petName &&
                         incoming().petBreed == existing().petBreed &&
                         incoming().serviceCode == existing().serviceCode &&
                         incoming().serviceName == existing().serviceName &&
                         incoming().dogSizeCode == existing().dogSizeCode &&
                         incoming().dateIso == existing().dateIso &&
                         incoming().timeSlotId == existing().timeSlotId &&
                         incoming().timeSlotLabel == existing().timeSlotLabel &&
                         incoming().slotKey == existing().slotKey &&
                         incoming().priceCop == existing().priceCop &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['statusCode', 'updatedAt']) &&
                         incoming().statusCode in ['CANCELADA', 'COMPLETADA'];

        allow delete: if false;
      }
    }

    match /occupied_slots/{slotKey} {
      // Zero PII: exposes only anonymous slot occupancy by exact key (dateIso_HH-00).
      allow get: if isSignedIn() && isValidId(slotKey);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(slotKey) &&
                       isValidOccupiedSlot(incoming(), slotKey) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId',
                         'appointmentId',
                         'dateIso',
                         'timeSlotId',
                         'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'appointmentId',
                         'dateIso',
                         'timeSlotId',
                         'createdAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/appointments/$(incoming().appointmentId));

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(slotKey) && existing().userId == request.auth.uid;
    }
  }
}
